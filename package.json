{
  "name": "levitolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "i18n:compile": "node ./scripts/i18n-compile.ts",
    "brand-assets": "node ./scripts/brand-assets/generate.ts",
    "pretest": "pnpm run i18n:compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:unit": "pnpm run i18n:compile",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "pretest:integration": "pnpm run i18n:compile",
    "test:integration": "vitest run --project integration",
    "test:integration:watch": "vitest --project integration",
    "pretest:coverage": "pnpm run i18n:compile",
    "test:coverage": "vitest run --coverage",
    "prelint": "pnpm run i18n:compile",
    "lint": "pnpm run \"/^lint:check:.*/\"",
    "prelint:fix": "pnpm run i18n:compile",
    "lint:fix": "pnpm run \"/^lint:fix:.*/\"",
    "lint:check:types": "tsc",
    "lint:check:quality": "oxlint .",
    "lint:check:style": "oxfmt --check .",
    "lint:check:deps": "knip",
    "lint:fix:style": "oxfmt .",
    "lint:fix:quality": "oxlint --fix .",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@inlang/paraglide-js": "2.22.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@vitejs/plugin-react": "6.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.26.0",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@inlang/plugin-message-format": "4.4.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-plugin-react-doctor": "0.9.1",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.17.0"
}
